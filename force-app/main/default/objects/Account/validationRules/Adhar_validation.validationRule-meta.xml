<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Adhar_validation</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(ISBLANK(AADHAR_Number__c)) &amp;&amp; NOT(REGEX(AADHAR_Number__c, &quot;^[0-9*]{12}$&quot;))</errorConditionFormula>
    <errorDisplayField>AADHAR_Number__c</errorDisplayField>
    <errorMessage>AADHAR Number must be exactly 12 digits</errorMessage>
</ValidationRule>

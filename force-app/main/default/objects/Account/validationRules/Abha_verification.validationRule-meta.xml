<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Abha_verification</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(ISBLANK(ABHA_Number__c)) &amp;&amp; NOT(REGEX(ABHA_Number__c, &quot;^[0-9*]{14}$&quot;))</errorConditionFormula>
    <errorDisplayField>ABHA_Number__c</errorDisplayField>
    <errorMessage>ABHA Number must be exactly 12 digits</errorMessage>
</ValidationRule>

<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickActionWithoutHeader" 
    access="global"
    controller="AayushGuideController"
    >

    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    
    <aura:attribute name="recordId" type="String"/>
    
    <div class="full-height-width">
        <c:ayushPrescriptionParent recordId="{!v.recordId}" onclose="{!c.handleCancel}" />
    </div>
    
    <aura:html tag="style">
        /* Hides the default modal close (X) button */
        .slds-modal__close {
            display: none !important;
        }

        .cuf-content {
            padding: 0rem 0rem !important;
        }
        .slds-p-around--medium {
            padding: 0rem !important;
        }       
        .slds-modal__content{
            padding: 0rem !important;
            height:fit-content !important;
            max-height:fit-content !important;
        }
        
        @media (min-width: 48em) {
        .slds-modal__container {
           width:100% !important;
           max-width:85% !important;
        	height:100% !important;
        	padding:1rem 0rem !important;
        }
    }

   
    </aura:html>
</aura:component>
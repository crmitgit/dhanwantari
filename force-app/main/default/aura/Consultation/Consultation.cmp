<aura:component 
    implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickActionWithoutHeader"
    access="global">

    <!-- Record Id from Patient (Contact / Person Account) -->
    <aura:attribute name="recordId" type="String"/>

   <div class="full-height-width">
        <c:createConsultation 
            recordId="{!v.recordId}" 
            onclose="{!c.handleCancel}" />
    </div>

    <!-- Hide default modal UI -->
    <aura:html tag="style">
        .slds-modal__close {
            display: none !important;
        }

        .cuf-content {
            padding: 0rem !important;
        }

        .slds-p-around--medium {
            padding: 0rem !important;
        }

        .slds-modal__content {
            padding: 0rem !important;
            height: fit-content !important;
            max-height: fit-content !important;
        }

        @media (min-width: 48em) {
            .slds-modal__container {
                width: 100% !important;
                max-width: 85% !important;
                height: 100% !important;
                padding: 1rem 0rem !important;
            }
        }
    </aura:html>

</aura:component>